# Server
PORT=3000
APP_BASE_URL=https://your-app-or-website.example
CORS_ORIGINS=https://your-website.example

# PayPal: use sandbox while testing, live only after full validation
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# PayPal Subscription Plan IDs created in PayPal dashboard (sandbox/live IDs differ)
PAYPAL_PLAN_MONTHLY_ID=
PAYPAL_PLAN_YEARLY_ID=

# Product policy
FREE_TORRENT_MAX_BYTES=10485760
PREMIUM_TORRENT_MAX_BYTES=104857600

# Owner account: set to the exact email used by your verified Supabase Auth account
OWNER_EMAIL=

# Required by the server (names only here, never commit values)
DATABASE_URL=
PAYPAL_LIFETIME_PRICE_USD=39.99
# Optional: set if your PayPal plans do not cost 2.99 / 29.99 (webhook checks it)
PAYPAL_PLAN_MONTHLY_PRICE_USD=2.99
PAYPAL_PLAN_YEARLY_PRICE_USD=29.99

# Weekly free limits (server-side) and the week's time zone
FREE_WEEKLY_TOPAZ=10
FREE_WEEKLY_CHECK=5
FREE_WEEKLY_DOWNLOAD=5
USAGE_TZ=America/Costa_Rica

# Set to true only once email verification exists
OWNER_REQUIRE_VERIFIED=false

# --- 0.4.0: free trial (per device), anti-abuse, AI subtitles ---
# Days of free Premium for each new install (clock starts at the first launch). Default 7.
TRIAL_DAYS=7
# Accounts on one device that can use the trial (the rest are refused and logged). Default 2.
TRIAL_MAX_ACCOUNTS_PER_DEVICE=2
# New devices per IP per 24 h before the extra ones get no trial (a trial farm). Default 8.
TRIAL_MAX_DEVICES_PER_IP=8
# true = emulators get no trial. Leave false while you test on an emulator.
TRIAL_BLOCK_EMULATORS=false
# Secret salt for device/IP hashes (the raw device id and IP are never stored). Set any long random text.
DEVICE_PEPPER=
# Railway sits behind a proxy: needed so rate limits see the real client IP
TRUST_PROXY=true
# AI subtitles: any OpenAI-compatible speech-to-text endpoint
STT_API_KEY=
STT_API_URL=https://api.openai.com/v1/audio/transcriptions
STT_MODEL=whisper-1
# (Groq example) STT_API_URL=https://api.groq.com/openai/v1/audio/transcriptions  STT_MODEL=whisper-large-v3-turbo
SUBS_MAX_SECONDS=1800
SUBS_DAILY_SECONDS=7200
SUBS_MAX_BYTES=25165824
FREE_WEEKLY_DEADFRAMES=5
