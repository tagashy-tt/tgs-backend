# Server
PORT=3000
APP_BASE_URL=https://your-app-or-website.example
CORS_ORIGINS=https://your-website.example

# PayPal: use sandbox while testing, live only after full validation
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# PayPal Subscription Plan IDs created in PayPal dashboard (sandbox/live IDs differ)
PAYPAL_PLAN_MONTHLY_ID=
PAYPAL_PLAN_YEARLY_ID=

# Supabase project settings
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Product policy
FREE_TORRENT_MAX_BYTES=10485760
PREMIUM_TORRENT_MAX_BYTES=104857600

# Owner account: set to the exact email used by your verified Supabase Auth account
OWNER_EMAIL=
