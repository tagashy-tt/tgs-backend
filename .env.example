# Server
PORT=3000
APP_BASE_URL=https://your-app-or-website.example
CORS_ORIGINS=https://your-website.example

# PayPal: use sandbox while testing, live only after full validation
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# PayPal Subscription Plan IDs created in PayPal dashboard (sandbox/live IDs differ)
PAYPAL_PLAN_MONTHLY_ID=
PAYPAL_PLAN_YEARLY_ID=

# Product policy
FREE_TORRENT_MAX_BYTES=10485760
PREMIUM_TORRENT_MAX_BYTES=104857600

# Owner account: set to the exact email used by your verified Supabase Auth account
OWNER_EMAIL=

# Required by the server (names only here, never commit values)
DATABASE_URL=
PAYPAL_LIFETIME_PRICE_USD=39.99
# Optional: set if your PayPal plans do not cost 2.99 / 29.99 (webhook checks it)
PAYPAL_PLAN_MONTHLY_PRICE_USD=2.99
PAYPAL_PLAN_YEARLY_PRICE_USD=29.99

# Weekly free limits (server-side) and the week's time zone
FREE_WEEKLY_TOPAZ=10
FREE_WEEKLY_CHECK=5
FREE_WEEKLY_DOWNLOAD=5
USAGE_TZ=America/Costa_Rica

# Set to true only once email verification exists
OWNER_REQUIRE_VERIFIED=false

# Lifetime discount code (default code TAY'S-LAUNCH31; checked only on the server)
LIFETIME_PROMO_ENABLED=true
LIFETIME_PROMO_PRICE_USD=19.99
# LIFETIME_PROMO_PERCENT=20        (used only when PRICE_USD is not set)
# LIFETIME_PROMO_CODE=TAY'S-LAUNCH31
# LIFETIME_PROMO_UNTIL=2026-11-02T05:59:59Z

# Anti-clone lock: start with INTEGRITY_ENFORCE unset (only logs), confirm your own build passes, then set true
APP_CERT_SHA256=0779d51b857ed374e83c84f169d2ba8acf5d945bed0070f7e1d1c36290b773a3
APP_PACKAGE=com.tgs.uploader
# INTEGRITY_ENFORCE=true
